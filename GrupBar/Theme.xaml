<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Yüzeyler -->
    <LinearGradientBrush x:Key="IslandFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6262A38" Offset="0" />
        <GradientStop Color="#EE12141C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IslandStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.45" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6232735" Offset="0" />
        <GradientStop Color="#F815171F" Offset="1" />
    </LinearGradientBrush>

    <!-- Vurgu: mavi ile mor arasında tek imza rengi -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5CC6FF" Offset="0" />
        <GradientStop Color="#9B7BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7FD8FF" Offset="0" />
        <GradientStop Color="#3B82FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FolderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD98A" Offset="0" />
        <GradientStop Color="#F0A93C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#267FA8FF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3ABBD" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- İpucu -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="10"
                            Padding="10,6"
                            Background="{StaticResource PopupFill}"
                            BorderBrush="{StaticResource IslandStroke}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sağ tık menüleri -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="14"
                            Padding="0,5"
                            MinWidth="190"
                            Background="{StaticResource PopupFill}"
                            BorderBrush="{StaticResource IslandStroke}"
                            BorderThickness="1"
                            CornerRadius="13">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,5" Background="{StaticResource DividerBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Margin="5,1" Padding="8,6" CornerRadius="8" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check"
                                  Data="M0,4 L3.5,7.5 L10,0.5"
                                  Stroke="{StaticResource AccentGradient}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Path x:Name="Arrow"
                                  Grid.Column="2"
                                  Data="M0,0 L4,4 L0,8"
                                  Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-8"
                                   VerticalOffset="-20"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="14"
                                        Padding="0,5"
                                        MinWidth="170"
                                        Background="{StaticResource PopupFill}"
                                        BorderBrush="{StaticResource IslandStroke}"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
