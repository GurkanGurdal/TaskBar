<Window x:Class="GrupBar.StoreAppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store uygulaması ekle"
        Width="380"
        Height="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <DockPanel Margin="12">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" TextChanged="FilterBox_TextChanged" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Ekle" Width="76" IsDefault="True" IsEnabled="False" Click="AddButton_Click" />
            <Button Content="İptal" Width="76" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="AppList"
                 Margin="0,8,0,0"
                 SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 SelectionChanged="AppList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Shell.LargeIcon}" Width="24" Height="24" />
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
