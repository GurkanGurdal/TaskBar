<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows API'leri (medya oturumu, Wi-Fi, Bluetooth) için SDK sürümlü hedef. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Exe yeri değişmesin: "Windows'la başlat" kaydı tam yolu tutuyor. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GrupBar.ico</ApplicationIcon>
    <!-- WinForms'un manifest DPI uyarısı: uygulama WPF, PerMonitorV2 manifestte kalmalı. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Yalnızca NotifyIcon için; WPF adlarıyla çakışmasın diye genel using olmasın. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Resource Include="GrupBar.ico" />
  </ItemGroup>

</Project>
