<Window x:Class="GrupBar.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grup adı"
        Width="320"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="12">
        <TextBox x:Name="NameBox" MaxLength="40" TextChanged="NameBox_TextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Tamam" Width="76" IsDefault="True" Click="OkButton_Click" />
            <Button Content="İptal" Width="76" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
