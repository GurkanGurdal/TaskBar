<UserControl x:Class="GrupBar.QuickSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrupBar"
             Width="340"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <!-- Windows 11'de Fluent, Windows 10'da MDL2 ikonları -->
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Yuvarlak, zemini yalnızca üzerine gelince görünen düğme -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kutunun yüzeyi: kapalıyken cam üstünde hafif, açıkken vurgu renginde -->
        <Style x:Key="TilePart" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <!-- Açık kutunun zemini beyaz: orada üzerine gelmek koyulaştırır -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Plate" Property="Background" Value="#14000000" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Satır (kutu + ad + alt pay) sayfa yüksekliğinin yarısına sığmalı, yoksa ad alttan kesilir -->
        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="96" Margin="0,0,0,7">
                <Border Height="48" CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14FFFFFF" />
                            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFill}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentFill}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Width="38"
                                Style="{StaticResource TilePart}"
                                AutomationProperties.Name="{Binding Label, StringFormat={}{0} ayarları}"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                                Click="TileMore_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE76C;" />
                        </Button>
                        <!-- Kutunun iki bölümü arasındaki ince çizgi -->
                        <Border DockPanel.Dock="Right"
                                Width="1"
                                Margin="0,11"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#26FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Background" Value="#26000000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Button Style="{StaticResource TilePart}"
                                AutomationProperties.Name="{Binding Label}"
                                Click="TilePrimary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="10"
                                           Margin="7,0,0,0"
                                           Text="&#xE76C;"
                                           Visibility="{Binding OpensMenu, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Label}"
                           FontSize="11.5"
                           Margin="0,5,0,0"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- Alt sayfa satırı: seçili olan vurgulu -->
        <Style x:Key="OptionRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OptionTemplate">
            <Button Style="{StaticResource OptionRow}" Click="SubOption_Click">
                <DockPanel>
                    <Border Width="4" Height="16" CornerRadius="2" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Background="{StaticResource AccentFill}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Grid Width="30" Height="22" Margin="0,0,11,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="16" Text="{Binding Glyph}" />
                        <Path Data="{Binding Picture}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11"
                                   Opacity="0.75"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding DetailVisibility}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="PromptButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PromptPassword" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentFill}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TilePage" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kaydırıcı: dolu kısım vurgu renginde, yuvarlak tutamaç -->
        <Style x:Key="RailFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="22">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource RailFill}" Background="{StaticResource AccentFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource RailFill}" Background="#40FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource AccentFill}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.4" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Medya kartının ana düğmesi: tek dolu yuvarlak -->
        <Style x:Key="MediaPlayButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{StaticResource AccentFill}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İlerleme çubuğu: rengi Foreground'dan (kapaktan), tutamaç üzerine gelince görünür -->
        <Style x:Key="MediaSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentFill}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="14">
                            <Track.DecreaseRepeatButton>
                                <!-- Tutamaç gizliyken de yer kaplar; iki parça onun altında birleşsin, boşluk kalmasın -->
                                <RepeatButton Style="{StaticResource RailFill}" Margin="0,0,-7,0" Background="{TemplateBinding Foreground}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource RailFill}" Margin="-5,0,0,0" Background="#40FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Focusable="False" Width="12" Height="12" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource AccentFill}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Çalan medya: oturum yoksa görünmez -->
        <local:GlassCard x:Name="MediaCard"
                         Opacity="1"
                         Margin="0,0,0,10"
                         CornerRadius="16"
                         Visibility="Collapsed">
            <Grid>
                <!-- Arka plan: kapağın bulanık hali, camın üstüne hafif bir renk olarak; cam görünmeye devam etsin. Köşeler kodda kırpılı. -->
                <Grid x:Name="MediaBackdropHost" Margin="1" IsHitTestVisible="False" SizeChanged="MediaBackdropHost_SizeChanged">
                    <!-- Opacity, koddaki MediaBackdropOpacity ile aynı olmalı -->
                    <Rectangle x:Name="MediaBackdropImage" Margin="-48" Opacity="0.35">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="MediaBackdrop" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Performance" />
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <StackPanel Margin="14,14,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <!-- Kapak kartın odağı; duraklatınca hafifçe küçülür -->
                        <Border x:Name="MediaArtHost" Width="76" Height="76" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MediaArtScale" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <ImageBrush x:Name="MediaArt" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <DockPanel VerticalAlignment="Top">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}"
                                        Width="24"
                                        Height="24"
                                        Margin="0,-3,-4,0"
                                        AutomationProperties.Name="Uygulamaya git"
                                        Click="MediaApp_Click">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE76C;" />
                                </Button>
                                <!-- Çalarken oynayan küçük çubuklar -->
                                <StackPanel x:Name="MediaEqualizer"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            Height="10"
                                            Margin="6,0,4,0"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed">
                                    <Rectangle Width="2" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentFill}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="MediaEq1" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="2,0" Fill="{StaticResource AccentFill}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="MediaEq2" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentFill}" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="MediaEq3" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                                <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaAppGlyph" Style="{StaticResource Glyph}" FontSize="12" Text="&#xEC4F;" />
                                    <Image x:Name="MediaAppIcon" />
                                </Grid>
                                <TextBlock x:Name="MediaAppName" FontSize="11" Opacity="0.85" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock x:Name="MediaTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtist" FontSize="12" Opacity="0.85" Margin="0,1,0,3" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- İlerleme: rengi kapaktan; süresi bildirilmeyen medyada gizli -->
                    <StackPanel x:Name="MediaTimeline" Margin="0,10,0,0">
                        <Slider x:Name="MediaProgress"
                                Style="{StaticResource MediaSlider}"
                                AutomationProperties.Name="Parça konumu"
                                PreviewMouseLeftButtonUp="MediaProgress_PreviewMouseLeftButtonUp"
                                ValueChanged="MediaProgress_ValueChanged" />
                        <DockPanel Margin="0,-1,0,0">
                            <TextBlock x:Name="MediaRemaining" DockPanel.Dock="Right" FontSize="10.5" Opacity="0.75" />
                            <TextBlock x:Name="MediaElapsed" FontSize="10.5" Opacity="0.75" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="MediaPrevious" Style="{StaticResource GhostButton}" AutomationProperties.Name="Önceki" Click="MediaPrevious_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="16" Text="&#xE892;" />
                        </Button>
                        <Button x:Name="MediaPlayPause" Style="{StaticResource MediaPlayButton}" Margin="14,0" AutomationProperties.Name="Oynat veya duraklat" Click="MediaPlayPause_Click">
                            <TextBlock x:Name="MediaPlayGlyph" Style="{StaticResource Glyph}" FontSize="15" Text="&#xE768;" />
                        </Button>
                        <Button x:Name="MediaNext" Style="{StaticResource GhostButton}" AutomationProperties.Name="Sonraki" Click="MediaNext_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="16" Text="&#xE893;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </local:GlassCard>

        <local:GlassCard x:Name="SettingsCard" Opacity="1" CornerRadius="16">
            <Grid x:Name="SettingsHost" ClipToBounds="True">
            <StackPanel x:Name="MainView">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MainSlide" />
                </StackPanel.RenderTransform>
                <!-- Sayfalı kutular; tekerlek ya da noktalarla geçilir -->
                <DockPanel Margin="16,16,8,4" Background="Transparent" MouseWheel="Tiles_MouseWheel">
                    <StackPanel x:Name="PageDots" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,14" />
                    <!-- Pencere: bir sayfa boyu. Sayfalar içinde alt alta durur, şerit kayar (ShowPage).
                         Canvas şart: Grid şeridi kendi boyuna kırpar, ikinci sayfa boş görünür. -->
                    <Canvas x:Name="TileViewport" Height="152" ClipToBounds="True">
                        <ItemsControl x:Name="Pages" Focusable="False" Width="{Binding ActualWidth, ElementName=TileViewport}">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="PagesSlide" />
                            </ItemsControl.RenderTransform>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl Style="{StaticResource TilePage}" Height="152" ItemsSource="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </DockPanel>

                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <StackPanel Margin="14,10,10,10">
                    <DockPanel x:Name="BrightnessRow" Margin="0,0,0,4">
                        <Border DockPanel.Dock="Right" Width="44" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Width="34" TextAlignment="Center" Text="&#xE706;" />
                        <Slider x:Name="BrightnessSlider"
                                Style="{StaticResource QuickSlider}"
                                AutomationProperties.Name="Parlaklık"
                                ValueChanged="BrightnessSlider_ValueChanged" />
                    </DockPanel>
                    <DockPanel x:Name="VolumeRow">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Width="44"
                                AutomationProperties.Name="Ses ayarları"
                                Click="VolumeMixer_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9E9;" />
                                <TextBlock Style="{StaticResource Glyph}" FontSize="10" Margin="4,0,0,0" Text="&#xE76C;" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="Sesi kapat veya aç"
                                Click="VolumeMute_Click">
                            <local:VolumeIcon x:Name="VolumeGlyph" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="15" />
                        </Button>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource QuickSlider}"
                                AutomationProperties.Name="Ses"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </DockPanel>
                </StackPanel>

                <!-- Alt şerit: pil ve ayarlar -->
                <Border Background="#1A000000" CornerRadius="0,0,15,15" Padding="16,6,10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="Ayarlar"
                                Click="Settings_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        </Button>
                        <Button x:Name="BatteryButton"
                                Style="{StaticResource GhostButton}"
                                Width="Auto"
                                HorizontalAlignment="Left"
                                Padding="0"
                                AutomationProperties.Name="Pil ayarları"
                                Click="Battery_Click">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Glyph}" FontSize="16" />
                                <TextBlock x:Name="BatteryText" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </StackPanel>

                <!-- Alt sayfa: ana görünümle aynı yerde, yandan kayarak gelir. Kartın boyu değişmesin diye ana görünüm yerinde kalır. -->
                <Border x:Name="SubView" Visibility="Collapsed" Padding="10" Height="{Binding ActualHeight, ElementName=MainView}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SubSlide" />
                    </Border.RenderTransform>
                    <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostButton}"
                                Width="30"
                                Height="30"
                                AutomationProperties.Name="Geri"
                                ToolTip="Geri"
                                Click="SubBack_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE72B;" />
                        </Button>
                        <!-- İlgili Windows ayarları: liste uzasa da hep görünür -->
                        <Button x:Name="SubSettings"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Width="30"
                                Height="30"
                                Visibility="Collapsed"
                                Click="SubSettings_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE713;" />
                        </Button>
                        <TextBlock x:Name="SubTitle" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SubNote"
                               DockPanel.Dock="Bottom"
                               FontSize="11"
                               Opacity="0.75"
                               Margin="10,6,10,2"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <!-- Bağlantıyı değiştiren eylemlerin onayı; gerekirse parola -->
                    <StackPanel x:Name="SubPrompt" DockPanel.Dock="Bottom" Margin="6,8,6,2" Visibility="Collapsed">
                        <TextBlock x:Name="SubPromptText" FontSize="12" Margin="2,0,2,7" TextWrapping="Wrap" />
                        <PasswordBox x:Name="SubPassword"
                                     Style="{StaticResource PromptPassword}"
                                     Margin="0,0,0,7"
                                     AutomationProperties.Name="Parola"
                                     PasswordChanged="SubPassword_PasswordChanged"
                                     KeyDown="SubPassword_KeyDown" />
                        <UniformGrid Columns="2">
                            <Button x:Name="SubPromptConfirm" Style="{StaticResource PromptButton}" Background="{StaticResource AccentFill}" Foreground="{StaticResource AccentInk}" Margin="0,0,3,0" Click="SubPromptConfirm_Click" />
                            <Button Style="{StaticResource PromptButton}" Background="#14FFFFFF" Margin="3,0,0,0" Content="Vazgeç" Click="SubPromptCancel_Click" />
                        </UniformGrid>
                    </StackPanel>
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SubItems" Focusable="False" ItemTemplate="{StaticResource OptionTemplate}" />
                    </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </local:GlassCard>
    </StackPanel>
</UserControl>
