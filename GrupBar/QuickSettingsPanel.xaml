<UserControl x:Class="GrupBar.QuickSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrupBar"
             Width="340"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <!-- Windows 11'de Fluent, Windows 10'da MDL2 ikonları -->
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Yuvarlak, zemini yalnızca üzerine gelince görünen düğme -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kutunun yüzeyi: kapalıyken cam üstünde hafif, açıkken vurgu renginde -->
        <Style x:Key="TilePart" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <!-- Açık kutunun zemini beyaz: orada üzerine gelmek koyulaştırır -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Plate" Property="Background" Value="#14000000" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="96" Margin="0,0,0,10">
                <Border Height="48" CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#14FFFFFF" />
                            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentFill}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentFill}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Width="38"
                                Style="{StaticResource TilePart}"
                                AutomationProperties.Name="{Binding Label, StringFormat={}{0} ayarları}"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                                Click="TileMore_Click">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE76C;" />
                        </Button>
                        <!-- Kutunun iki bölümü arasındaki ince çizgi -->
                        <Border DockPanel.Dock="Right"
                                Width="1"
                                Margin="0,11"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#26FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Background" Value="#26000000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Button Style="{StaticResource TilePart}"
                                AutomationProperties.Name="{Binding Label}"
                                Click="TilePrimary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="10"
                                           Margin="7,0,0,0"
                                           Text="&#xE76C;"
                                           Visibility="{Binding OpensMenu, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Label}"
                           FontSize="11.5"
                           Margin="0,5,0,0"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!-- Kaydırıcı: dolu kısım vurgu renginde, yuvarlak tutamaç -->
        <Style x:Key="RailFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="22">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource RailFill}" Background="{StaticResource AccentFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource RailFill}" Background="#40FFFFFF" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource AccentFill}">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.4" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Çalan medya: oturum yoksa görünmez -->
        <local:GlassCard x:Name="MediaCard"
                         Opacity="1"
                         Margin="0,0,0,10"
                         CornerRadius="16"
                         Visibility="Collapsed">
            <Grid>
                <!-- Arka plan: kapağın bulanık hali, camın üstüne hafif bir renk olarak; cam görünmeye devam etsin. Köşeler kodda kırpılı. -->
                <Grid x:Name="MediaBackdropHost" Margin="1" IsHitTestVisible="False" SizeChanged="MediaBackdropHost_SizeChanged">
                    <Rectangle Margin="-48" Opacity="0.35">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="MediaBackdrop" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Performance" />
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <StackPanel Margin="16,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource GhostButton}"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="Uygulamaya git"
                            Click="MediaApp_Click">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="&#xE76C;" />
                    </Button>
                    <Grid Width="16" Height="16" Margin="0,0,7,0">
                        <TextBlock x:Name="MediaAppGlyph" Style="{StaticResource Glyph}" FontSize="13" Text="&#xEC4F;" />
                        <Image x:Name="MediaAppIcon" />
                    </Grid>
                    <TextBlock x:Name="MediaAppName" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DockPanel Margin="0,8,0,4">
                    <Border DockPanel.Dock="Right" Width="58" Height="58" CornerRadius="8" Margin="12,0,0,0">
                        <Border.Background>
                            <ImageBrush x:Name="MediaArt" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaArtist" FontSize="12" Opacity="0.85" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="MediaPrevious" Style="{StaticResource GhostButton}" Margin="6,0" AutomationProperties.Name="Önceki" Click="MediaPrevious_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="MediaPlayPause" Style="{StaticResource GhostButton}" Margin="6,0" AutomationProperties.Name="Oynat veya duraklat" Click="MediaPlayPause_Click">
                        <TextBlock x:Name="MediaPlayGlyph" Style="{StaticResource Glyph}" FontSize="17" Text="&#xE768;" />
                    </Button>
                    <Button x:Name="MediaNext" Style="{StaticResource GhostButton}" Margin="6,0" AutomationProperties.Name="Sonraki" Click="MediaNext_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" />
                    </Button>
                </StackPanel>
                </StackPanel>
            </Grid>
        </local:GlassCard>

        <local:GlassCard x:Name="SettingsCard" Opacity="1" CornerRadius="16">
            <StackPanel>
                <!-- Sayfalı kutular; tekerlek ya da noktalarla geçilir -->
                <DockPanel Margin="16,16,8,4" Background="Transparent" MouseWheel="Tiles_MouseWheel">
                    <StackPanel x:Name="PageDots" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,14" />
                    <ItemsControl x:Name="Tiles" Focusable="False" ItemTemplate="{StaticResource TileTemplate}" MinHeight="146">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>

                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <StackPanel Margin="14,10,10,10">
                    <DockPanel x:Name="BrightnessRow" Margin="0,0,0,4">
                        <Border DockPanel.Dock="Right" Width="44" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Width="34" Text="&#xE706;" />
                        <Slider x:Name="BrightnessSlider"
                                Style="{StaticResource QuickSlider}"
                                AutomationProperties.Name="Parlaklık"
                                ValueChanged="BrightnessSlider_ValueChanged" />
                    </DockPanel>
                    <DockPanel x:Name="VolumeRow">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                Width="44"
                                AutomationProperties.Name="Ses ayarları"
                                Click="VolumeMixer_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9E9;" />
                                <TextBlock Style="{StaticResource Glyph}" FontSize="10" Margin="4,0,0,0" Text="&#xE76C;" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="Sesi kapat veya aç"
                                Click="VolumeMute_Click">
                            <local:VolumeIcon x:Name="VolumeGlyph" TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="15" />
                        </Button>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource QuickSlider}"
                                AutomationProperties.Name="Ses"
                                ValueChanged="VolumeSlider_ValueChanged" />
                    </DockPanel>
                </StackPanel>

                <!-- Alt şerit: pil ve ayarlar -->
                <Border Background="#1A000000" CornerRadius="0,0,15,15" Padding="16,6,10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="Ayarlar"
                                Click="Settings_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        </Button>
                        <Button x:Name="BatteryButton"
                                Style="{StaticResource GhostButton}"
                                Width="Auto"
                                HorizontalAlignment="Left"
                                Padding="0"
                                AutomationProperties.Name="Pil ayarları"
                                Click="Battery_Click">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Glyph}" FontSize="16" />
                                <TextBlock x:Name="BatteryText" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </StackPanel>
        </local:GlassCard>
    </StackPanel>
</UserControl>
