<Window x:Class="GrupBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrupBar Ayarları"
        Width="440"
        Height="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="8,0,0,4" />
        </Style>
    </Window.Resources>
    <TabControl Margin="8">
        <TabItem Header="Genel">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kenar" VerticalAlignment="Center" />
                    <ComboBox x:Name="EdgeBox"
                              Grid.Column="1"
                              AutomationProperties.Name="Kenar"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Edge}" />
                    <TextBlock Grid.Row="1" Text="Kalınlık" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox x:Name="ThicknessBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Kalınlık"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Thickness}" />
                </Grid>
                <CheckBox x:Name="ClockCheck" Content="Saati göster" Margin="0,16,0,0" IsChecked="{Binding ShowClock}" />
                <CheckBox Content="Tarihi göster"
                          Margin="20,6,0,0"
                          IsChecked="{Binding ShowDate}"
                          IsEnabled="{Binding IsChecked, ElementName=ClockCheck}" />
                <CheckBox x:Name="StartupCheck" Content="Windows'la başlat" Margin="0,16,0,0" />
                <CheckBox Content="Windows görev çubuğunu gizle" Margin="0,6,0,0" IsChecked="{Binding HideWindowsTaskbar}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Kapalıyken GrupBar, Windows çubuğunun yanında ek çubuk olarak durur." />
            </StackPanel>
        </TabItem>
        <TabItem Header="Düzen">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="Sabitlenen uygulamalar" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="PinnedList"
                         Grid.Row="1"
                         AutomationProperties.Name="Sabitlenen uygulamalar"
                         ItemsSource="{Binding Pinned}"
                         DisplayMemberPath="Name"
                         SelectionChanged="List_SelectionChanged" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Button x:Name="PinnedUpButton" Style="{StaticResource SideButton}" Content="Yukarı" Click="PinnedUpButton_Click" />
                    <Button x:Name="PinnedDownButton" Style="{StaticResource SideButton}" Content="Aşağı" Click="PinnedDownButton_Click" />
                    <Button x:Name="PinnedRemoveButton" Style="{StaticResource SideButton}" Content="Kaldır" Click="PinnedRemoveButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Gruplar" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ListBox x:Name="GroupList"
                         Grid.Row="3"
                         AutomationProperties.Name="Gruplar"
                         ItemsSource="{Binding Groups}"
                         DisplayMemberPath="Name"
                         SelectionChanged="List_SelectionChanged" />
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <Button x:Name="GroupUpButton" Style="{StaticResource SideButton}" Content="Yukarı" Click="GroupUpButton_Click" />
                    <Button x:Name="GroupDownButton" Style="{StaticResource SideButton}" Content="Aşağı" Click="GroupDownButton_Click" />
                    <Button x:Name="GroupRenameButton" Style="{StaticResource SideButton}" Content="Yeniden adlandır" Click="GroupRenameButton_Click" />
                    <Button x:Name="GroupDeleteButton" Style="{StaticResource SideButton}" Content="Sil" Click="GroupDeleteButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Eklemek için dosyaları çubuğa sürükleyin ya da çubuğa sağ tıklayın." />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
