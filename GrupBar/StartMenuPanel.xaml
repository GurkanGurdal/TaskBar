<UserControl x:Class="GrupBar.StartMenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GrupBar"
             Width="680"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Kutunun üzerine gelince ikon hafifçe büyür. Dönüşüm öğede tanımlı: stildeki dondurulur. -->
        <Style x:Key="IconPop" TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.14" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.14" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Zemini yalnızca üzerine gelince görünen düğme -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Klavyeyle seçilen sonuç vurgulu -->
        <Style x:Key="ResultRow" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentFill}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource ClockFont}" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="6,0,0,6" />
        </Style>

        <!-- Kutu başına ayrı örnek: ortak olursa hangi uygulamada açıldığını bilemez -->
        <ContextMenu x:Key="TileMenu" x:Shared="False" Opened="TileMenu_Opened">
            <MenuItem Header="Başlat'a sabitle" Click="PinToStart_Click" />
            <MenuItem Header="Başlat'tan kaldır" Click="UnpinFromStart_Click" />
            <MenuItem Header="Çubuğa sabitle" Click="PinToBar_Click" />
        </ContextMenu>

        <!-- Sabitlenenler: rıhtım gibi, yalnızca büyük ikon; ad ipucunda -->
        <DataTemplate x:Key="PinTemplate">
            <Button Style="{StaticResource PlainButton}"
                    Height="66"
                    AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}"
                    ToolTipService.InitialShowDelay="250"
                    ContextMenu="{StaticResource TileMenu}"
                    Click="Tile_Click">
                <Image Source="{Binding Icon}" Width="42" Height="42" Style="{StaticResource IconPop}">
                    <Image.RenderTransform>
                        <ScaleTransform />
                    </Image.RenderTransform>
                </Image>
            </Button>
        </DataTemplate>

        <!-- Son kullanılanlar: yan yana küçük şeritler -->
        <DataTemplate x:Key="RecentTemplate">
            <Button Style="{StaticResource PlainButton}"
                    Background="#12FFFFFF"
                    Height="44"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}"
                    ContextMenu="{StaticResource TileMenu}"
                    Click="Tile_Click">
                <DockPanel Margin="10,0">
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="24" Height="24" Style="{StaticResource IconPop}">
                        <Image.RenderTransform>
                            <ScaleTransform />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AppTemplate">
            <Button Style="{StaticResource PlainButton}"
                    AutomationProperties.Name="{Binding Name}"
                    ToolTip="{Binding Name}"
                    ContextMenu="{StaticResource TileMenu}"
                    Click="Tile_Click">
                <StackPanel Margin="4,9,4,7">
                    <Image Source="{Binding Icon}" Width="32" Height="32" Style="{StaticResource IconPop}">
                        <Image.RenderTransform>
                            <ScaleTransform />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="{Binding Name}"
                               FontSize="11.5"
                               Margin="0,7,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Harf grubu: solda büyük ince harf, yanında uygulamalar -->
        <DataTemplate x:Key="LetterTemplate">
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left"
                           Width="34"
                           Margin="6,4,0,0"
                           Text="{Binding Letter}"
                           FontFamily="{StaticResource ClockFont}"
                           FontWeight="Light"
                           FontSize="22"
                           Opacity="0.45" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" ItemTemplate="{StaticResource AppTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="104" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </DataTemplate>

        <!-- Sonuç satırı: klavyeyle seçilende Enter ipucu -->
        <DataTemplate x:Key="ResultTemplate">
            <Button Style="{StaticResource ResultRow}"
                    Height="48"
                    AutomationProperties.Name="{Binding Name}"
                    ContextMenu="{StaticResource TileMenu}"
                    Click="Tile_Click">
                <DockPanel Margin="10,0,12,0">
                    <Border DockPanel.Dock="Right" CornerRadius="5" Background="#1FFFFFFF" Padding="8,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Aç  ↵" FontSize="11" />
                    </Border>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="30" Height="30" Style="{StaticResource IconPop}">
                        <Image.RenderTransform>
                            <ScaleTransform />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="{Binding Name}" FontSize="14" Margin="13,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Büyük kartta metin ağırlıklı: arkadaki pencerelerin yazısı okunmasın diye daha bulanık ve hafif koyu -->
    <local:GlassCard x:Name="Card" Opacity="1" CornerRadius="16" BlurRadius="24">
        <Grid x:Name="Body" Height="600" Background="#30101216">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sol şerit: hesap yukarıda; yerler ve güç aşağıda -->
            <Border Background="#1F000000" CornerRadius="16,0,0,16">
                <DockPanel Margin="0,12">
                    <Button x:Name="AccountButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource RailButton}"
                            AutomationProperties.Name="Hesap ayarları"
                            ToolTip="Hesap ayarları"
                            Click="Account_Click">
                        <Grid Width="30" Height="30">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="17" Text="&#xE77B;" />
                            <Border x:Name="AccountPicture" CornerRadius="9" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <Button Style="{StaticResource RailButton}" AutomationProperties.Name="Belgeler" ToolTip="Belgeler" Tag="shell:Personal" Click="Place_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" AutomationProperties.Name="İndirilenler" ToolTip="İndirilenler" Tag="shell:Downloads" Click="Place_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" AutomationProperties.Name="Resimler" ToolTip="Resimler" Tag="shell:My Pictures" Click="Place_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9F;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" AutomationProperties.Name="Dosya Gezgini" ToolTip="Dosya Gezgini" Tag="explorer.exe" Click="Place_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" />
                        </Button>
                        <Border Height="1" Width="22" Margin="0,6" Background="{StaticResource DividerBrush}" />
                        <Button Style="{StaticResource RailButton}" AutomationProperties.Name="Ayarlar" ToolTip="Ayarlar" Tag="ms-settings:" Click="Place_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                        </Button>
                        <Button x:Name="PowerButton"
                                Style="{StaticResource RailButton}"
                                AutomationProperties.Name="Güç"
                                ToolTip="Güç"
                                Click="Power_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kilitle" Click="Lock_Click" />
                                    <MenuItem Header="Oturumu kapat" Click="SignOut_Click" />
                                    <Separator />
                                    <MenuItem Header="Uyku" Click="Sleep_Click" />
                                    <MenuItem Header="Yeniden başlat" Click="Restart_Click" />
                                    <MenuItem Header="Kapat" Click="ShutDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Windows Başlat menüsünü aç" Click="WindowsStart_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <!-- Arama: kutu yok, büyük yazı ve ince çizgi; açılınca odak burada -->
                <StackPanel DockPanel.Dock="Top" Margin="20,16,18,0">
                    <TextBlock x:Name="Greeting" FontSize="12" Opacity="0.6" />
                    <DockPanel Margin="0,5,0,10">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="17" Opacity="0.7" Margin="0,0,12,0" Text="&#xE721;" />
                        <Grid>
                            <TextBlock x:Name="SearchHint"
                                       Text="Ne açmak istersiniz?"
                                       FontFamily="{StaticResource ClockFont}"
                                       FontWeight="Light"
                                       FontSize="22"
                                       Opacity="0.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     AutomationProperties.Name="Uygulama ara"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        </Grid>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource DividerBrush}" />
                </StackPanel>

                <Grid>
                    <!-- Göz atma: sabitlenenler, son kullanılanlar, harf harf tüm uygulamalar -->
                    <Grid x:Name="BrowseView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="Scroller"
                                      Focusable="False"
                                      Margin="12,10,0,8"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="Scroller_ScrollChanged">
                            <StackPanel x:Name="ScrollContent">
                                <ItemsControl x:Name="PinnedList"
                                              Focusable="False"
                                              Margin="0,0,0,10"
                                              ItemTemplate="{StaticResource PinTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="72" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel x:Name="RecentSection" Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Son kullanılanlar" />
                                    <ItemsControl x:Name="RecentList" Focusable="False" ItemTemplate="{StaticResource RecentTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel x:Name="AppsSection">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tüm uygulamalar" />
                                    <ItemsControl x:Name="LetterGroups" Focusable="False" ItemTemplate="{StaticResource LetterTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Harf şeridi: tıklanan harfe kayar, görünen harf parlak -->
                        <Viewbox Grid.Column="1" StretchDirection="DownOnly" VerticalAlignment="Center" Margin="0,8">
                            <ItemsControl x:Name="LetterRail" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="24"
                                                Height="17"
                                                Focusable="False"
                                                AutomationProperties.Name="{Binding Letter}"
                                                Click="Letter_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock x:Name="Mark" Text="{Binding Letter}" FontSize="10" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                                            <Setter TargetName="Mark" Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </Grid>

                    <!-- Arama: tek sütun sonuç listesi, oklarla gezilir -->
                    <ScrollViewer x:Name="ResultsView"
                                  Focusable="False"
                                  Margin="12,10,14,8"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="ResultsList" Focusable="False" ItemTemplate="{StaticResource ResultTemplate}" />
                            <TextBlock x:Name="NoResults"
                                       Text="Uygulama bulunamadı"
                                       Opacity="0.7"
                                       FontSize="13"
                                       Margin="10,8,0,10"
                                       Visibility="Collapsed" />
                            <Button x:Name="WindowsSearchButton"
                                    Style="{StaticResource PlainButton}"
                                    Height="42"
                                    Margin="0,4,0,0"
                                    Click="WindowsSearch_Click">
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,16,0" Text="&#xE721;" />
                                    <TextBlock x:Name="WindowsSearchText" FontSize="12.5" Opacity="0.85" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </local:GlassCard>
</UserControl>
