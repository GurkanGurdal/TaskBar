<appbar:AppBarWindow x:Class="GrupBar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
        xmlns:tasks="clr-namespace:ManagedShell.WindowsTasks;assembly=ManagedShell.WindowsTasks"
        xmlns:local="clr-namespace:GrupBar"
        Title="GrupBar"
        Background="Transparent"
        AllowDrop="True"
        Deactivated="Window_Deactivated"
        LocationChanged="Window_PositionChanged"
        SizeChanged="Window_PositionChanged"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragOver"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ItemsPanelTemplate x:Key="BarItemsPanel">
            <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
        </ItemsPanelTemplate>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#505050" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static Orientation.Vertical}">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:ApplicationWindow+WindowState.Active}">
                    <Setter Property="Background" Value="#3A5A80" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:ApplicationWindow+WindowState.Flashing}">
                    <Setter Property="Background" Value="#9A6A20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static Orientation.Vertical}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Yeni grup..." Click="NewGroupItem_Click" />
            <MenuItem Header="Uygulama sabitle">
                <MenuItem Header="Program veya kısayol..." Click="PinFilesItem_Click" />
                <MenuItem Header="Klasör..." Click="PinFolderItem_Click" />
                <MenuItem Header="Store uygulaması..." Click="PinStoreAppItem_Click" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="EdgeMenu" Header="Kenar">
                <MenuItem Header="Alt" Tag="{x:Static appbar:AppBarEdge.Bottom}" Click="EdgeItem_Click" />
                <MenuItem Header="Üst" Tag="{x:Static appbar:AppBarEdge.Top}" Click="EdgeItem_Click" />
                <MenuItem Header="Sol" Tag="{x:Static appbar:AppBarEdge.Left}" Click="EdgeItem_Click" />
                <MenuItem Header="Sağ" Tag="{x:Static appbar:AppBarEdge.Right}" Click="EdgeItem_Click" />
            </MenuItem>
            <MenuItem Header="Otomatik gizle" IsCheckable="True" IsChecked="{Binding AutoHideBar}" />
            <MenuItem x:Name="ThicknessMenu" Header="Kalınlık">
                <MenuItem Header="İnce" Tag="32" Click="ThicknessItem_Click" />
                <MenuItem Header="Orta" Tag="40" Click="ThicknessItem_Click" />
                <MenuItem Header="Kalın" Tag="48" Click="ThicknessItem_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Ayarlar..." Click="SettingsItem_Click" />
            <MenuItem Header="Çıkış" Click="ExitItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid>
    <!-- Otomatik gizlemede fareyi yakalar. Alfa 1: gözle görünmez ama tıklama ve fare olaylarını alır. -->
    <Border x:Name="EdgeStrip" Background="#01000000" Visibility="Collapsed" />
    <Grid x:Name="BarRoot" Background="#202020">
        <DockPanel>
        <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="DockPanel.Dock" Value="Left" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static Orientation.Vertical}">
                            <Setter Property="DockPanel.Dock" Value="Top" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        <Button x:Name="StartButton"
                Style="{StaticResource FlatButton}"
                Padding="10,6"
                AutomationProperties.Name="Başlat"
                ToolTip="Başlat"
                PreviewMouseMove="StartButton_PreviewMouseMove"
                Click="StartButton_Click"
                MouseRightButtonUp="StartButton_MouseRightButtonUp">
            <Path Data="M0,0 H8 V8 H0 Z M10,0 H18 V8 H10 Z M0,10 H8 V18 H0 Z M10,10 H18 V18 H10 Z"
                  Fill="#5CB3F0"
                  Width="16"
                  Height="16"
                  Stretch="Uniform" />
        </Button>
        <ItemsControl ItemsSource="{Binding Pinned}" ItemsPanel="{StaticResource BarItemsPanel}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlatButton}"
                            Padding="8,6"
                            AutomationProperties.Name="{Binding Name}"
                            ToolTip="{Binding Name}"
                            Click="ItemButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Sabitlemeyi kaldır" Click="UnpinItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Image Source="{Binding Shell.LargeIcon}" Width="20" Height="20" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Groups}" ItemsPanel="{StaticResource BarItemsPanel}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlatButton}"
                            Padding="8,6"
                            AllowDrop="True"
                            AutomationProperties.Name="{Binding Name}"
                            ToolTip="{Binding Name}"
                            Click="GroupButton_Click"
                            DragEnter="GroupButton_DragEnter"
                            DragOver="GroupButton_DragOver"
                            DragLeave="GroupButton_DragLeave"
                            Drop="GroupButton_Drop">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Yeniden adlandır..." Click="RenameGroupItem_Click" />
                                <MenuItem Header="İkon seç..." Click="ChooseIconItem_Click" />
                                <MenuItem Header="Varsayılan ikon" Click="ResetIconItem_Click" />
                                <Separator />
                                <MenuItem Header="Sil" Click="DeleteGroupItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20">
                                <Image Source="{Binding Icon.LargeIcon}" />
                                <Path Data="M1,4 L8,4 L10,6 L19,6 L19,17 L1,17 Z" Fill="#E8C468">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                            <TextBlock Style="{StaticResource BarText}" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="Clock"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="DockPanel.Dock" Value="Right" />
                    <Setter Property="Margin" Value="10,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static Orientation.Vertical}">
                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                            <Setter Property="Margin" Value="0,6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock x:Name="TimeText" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="DateText" Foreground="#C8C8C8" FontSize="11" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BarText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDate}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ItemsControl x:Name="TrayList" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="DockPanel.Dock" Value="Right" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static Orientation.Vertical}">
                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4"
                            ToolTip="{Binding Title}"
                            MouseEnter="TrayIcon_MouseEnter"
                            MouseLeave="TrayIcon_MouseLeave"
                            MouseMove="TrayIcon_MouseMove"
                            MouseDown="TrayIcon_MouseDown"
                            MouseUp="TrayIcon_MouseUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A3A3A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding Icon}" Width="16" Height="16" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="TaskList" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:TaskPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource TaskButton}"
                            Padding="8,6"
                            AutomationProperties.Name="{Binding Title}"
                            ToolTip="{Binding Title}"
                            PreviewMouseLeftButtonDown="TaskButton_PreviewMouseLeftButtonDown"
                            Click="TaskButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pencereyi kapat" Click="CloseTaskItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" />
                            <TextBlock Style="{StaticResource BarText}"
                                       Text="{Binding Title}"
                                       Margin="6,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </DockPanel>

        <Popup x:Name="GroupPanel" StaysOpen="True" Opened="GroupPanel_OpenedOrClosed" Closed="GroupPanel_OpenedOrClosed">
            <Border Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" Padding="8" Width="356" AllowDrop="False">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="Hepsini aç"
                                Padding="8,4"
                                Margin="4,0,0,0"
                                Click="OpenAllButton_Click" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="Ekle"
                                Padding="8,4"
                                Click="AddButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Program veya kısayol..." Click="AddFilesItem_Click" />
                                    <MenuItem Header="Klasör..." Click="AddFolderItem_Click" />
                                    <MenuItem Header="Store uygulaması..." Click="AddStoreAppItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Foreground="#B0B0B0"
                               Text="Bu grup boş. Eklemek için dosyaları çubuktaki grubun üzerine sürükleyin ya da Ekle'ye tıklayın."
                               TextWrapping="Wrap"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlatButton}"
                                        Width="84"
                                        Padding="4,6"
                                        AutomationProperties.Name="{Binding Name}"
                                        ToolTip="{Binding Path}"
                                        Click="ItemButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Gruptan kaldır" Click="RemoveItem_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Image Source="{Binding Shell.LargeIcon}" Width="32" Height="32" />
                                        <TextBlock Text="{Binding Name}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Grid>
</appbar:AppBarWindow>
