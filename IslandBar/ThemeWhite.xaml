<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Beyaz tema: cam yok, opak kırık beyaz. Derinlik geçişle değil ince çizgi ve yumuşak gölgeyle. Anahtarlar ThemeGlass.xaml ile aynı olmalı. -->

    <!-- Yüzeyler -->
    <Color x:Key="SurfaceColor">#FAFAFB</Color>
    <SolidColorBrush x:Key="IslandStroke" Color="#17000000" />
    <SolidColorBrush x:Key="IslandSheen" Color="Transparent" />
    <SolidColorBrush x:Key="PopupFill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StartBodyVeil" Color="Transparent" />
    <SolidColorBrush x:Key="MenuVeil" Color="Transparent" />
    <SolidColorBrush x:Key="StartRailFill" Color="#08000000" />
    <SolidColorBrush x:Key="FooterFill" Color="#08000000" />

    <!-- Vurgu: koyu dolgu, üstünde beyaz. Açık zeminde tek güçlü yüzey bu. -->
    <SolidColorBrush x:Key="AccentFill" Color="#171717" />
    <SolidColorBrush x:Key="AccentInk" Color="#FAFAFB" />
    <SolidColorBrush x:Key="OnAccentHover" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="OnAccentDivider" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FolderGradient" Color="#E8940F" />
    <SolidColorBrush x:Key="AttentionFill" Color="#E8890C" />

    <!-- Düğme ve kutu zeminleri -->
    <SolidColorBrush x:Key="SubtleFill" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleStroke" Color="#0F000000" />
    <SolidColorBrush x:Key="MutedFill" Color="#14000000" />
    <SolidColorBrush x:Key="RailTrack" Color="#1F000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#17000000" />
    <SolidColorBrush x:Key="DropHighlight" Color="#26000000" />
    <SolidColorBrush x:Key="ShotStroke" Color="#14000000" />
    <SolidColorBrush x:Key="ShotStrokeHover" Color="#66000000" />

    <!-- Çalışan uygulama göstergeleri -->
    <SolidColorBrush x:Key="MarkFill" Color="#59000000" />

    <SolidColorBrush x:Key="TextPrimary" Color="#171717" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E76" />

    <!-- Gölgeler: siyah değil, hafif mavimsi ve geniş; ışık yukarıdan -->
    <Color x:Key="ShadowColor">#20232E</Color>
    <!-- Çubuktaki uygulama ikonlarının altındaki kısa, yumuşak gölge (macOS Dock gibi): açık ikon açık zeminde de seçilsin -->
    <Color x:Key="IconShadowColor">#000000</Color>
    <sys:Double x:Key="IconShadowOpacity">0.32</sys:Double>
    <sys:Double x:Key="IslandShadowBlur">14</sys:Double>
    <sys:Double x:Key="IslandShadowDepth">2</sys:Double>
    <sys:Double x:Key="IslandShadowOpacity">0.22</sys:Double>
    <sys:Double x:Key="CardShadowBlur">24</sys:Double>
    <sys:Double x:Key="CardShadowDepth">6</sys:Double>
    <sys:Double x:Key="CardShadowDirection">270</sys:Double>
    <sys:Double x:Key="CardShadowOpacity">0.18</sys:Double>
</ResourceDictionary>
