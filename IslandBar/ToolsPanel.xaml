<UserControl x:Class="IslandBar.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IslandBar"
             FontFamily="{StaticResource UiFont}"
             Width="452">
    <UserControl.Resources>
        <QuadraticEase x:Key="Soft" EasingMode="EaseOut" />

        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="10" Background="Transparent" Padding="8,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShotTemplate" DataType="{x:Type local:ScreenshotItem}">
            <Border x:Name="Tile"
                    Width="145"
                    Height="90"
                    Margin="0,0,8,8"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{StaticResource ShotStroke}"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    ToolTip="{Binding TimeLabel}"
                    MouseLeftButtonDown="Shot_MouseLeftButtonDown"
                    MouseMove="Shot_MouseMove"
                    MouseLeftButtonUp="Shot_MouseLeftButtonUp">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TileScale" />
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Kopyala" Click="CopyShot_Click" />
                        <MenuItem Header="Dosya konumunu aç" Click="RevealShot_Click" />
                        <Separator />
                        <MenuItem Header="Sil" Click="DeleteShot_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource ShotStrokeHover}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="IslandBar Araçları"
                   Foreground="{StaticResource TextPrimary}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,8">
            <Button x:Name="ClearButton"
                    DockPanel.Dock="Right"
                    Content="Temizle"
                    ToolTip="Bu listedeki kopyaları siler. Resimler klasörüne dokunmaz."
                    Style="{StaticResource ClearButton}"
                    Click="Clear_Click" />
            <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center">
                <Run Text="Ekran görüntüleri" />
                <Run x:Name="ShotCount" Foreground="{StaticResource TextSecondary}" FontSize="12" />
            </TextBlock>
        </DockPanel>

        <ItemsControl x:Name="ShotList" Focusable="False" ItemTemplate="{StaticResource ShotTemplate}" Margin="0,0,-8,-8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock x:Name="ShotHint"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   Text="Sürükleyip istediğin yere bırak. Tıklayınca açılır." />
        <TextBlock x:Name="EmptyHint"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12"
                   Margin="0,6,0,6"
                   TextWrapping="Wrap"
                   Text="Henüz görüntü yok. Win + Shift + S ya da Win + PrtScn ile aldıkların burada birikir, son 10 tanesi saklanır." />
    </StackPanel>
</UserControl>
