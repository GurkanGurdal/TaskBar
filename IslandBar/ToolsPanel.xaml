<UserControl x:Class="IslandBar.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IslandBar"
             FontFamily="{StaticResource UiFont}"
             AllowDrop="True"
             DragEnter="Panel_DragOver"
             DragOver="Panel_DragOver"
             DragLeave="Panel_DragLeave"
             Drop="Panel_Drop"
             Width="452">
    <UserControl.Resources>
        <QuadraticEase x:Key="Soft" EasingMode="EaseOut" />

        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="10" Background="Transparent" Padding="8,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShotTemplate" DataType="{x:Type local:ScreenshotItem}">
            <Border x:Name="Tile"
                    Width="145"
                    Height="90"
                    Margin="0,0,8,8"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{StaticResource ShotStroke}"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    ToolTip="{Binding TimeLabel}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseMove="Tile_MouseMove"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" AlignmentY="Top" />
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TileScale" />
                </Border.RenderTransform>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Kopyala" Click="CopyShot_Click" />
                        <MenuItem Header="Dosya konumunu aç" Click="RevealShot_Click" />
                        <Separator />
                        <MenuItem Header="Sil" Click="DeleteShot_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource ShotStrokeHover}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Soft}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kopyalanan metin: tek satır, saat sağda (kullanıcının seçtiği liste düzeni) -->
        <DataTemplate x:Key="CopiedTemplate" DataType="{x:Type local:CopiedText}">
            <Border x:Name="Row"
                    Height="32"
                    Margin="0,0,0,2"
                    Padding="10,0"
                    CornerRadius="8"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="{Binding ToolTipText}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseMove="Tile_MouseMove"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Kopyala" Click="CopyText_Click" />
                        <Separator />
                        <MenuItem Header="Listeden kaldır" Click="RemoveText_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               Text="{Binding TimeLabel}" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Preview}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ShelfTemplate" DataType="{x:Type local:ShelfItem}">
            <Border x:Name="Tile"
                    Width="107"
                    Height="78"
                    Margin="0,0,8,8"
                    CornerRadius="10"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="{Binding Path}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseMove="Tile_MouseMove"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Dosya konumunu aç" Click="RevealShelf_Click" />
                        <Separator />
                        <MenuItem Header="Raftan kaldır" Click="RemoveShelf_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{Binding Icon, Converter={StaticResource IconInk}}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Width="32"
                           Height="32" />
                    <TextBlock Text="{Binding Name}"
                               Margin="6,6,6,0"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="IslandBar Araçları"
                   Foreground="{StaticResource TextPrimary}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,8">
            <Button x:Name="ClearButton"
                    DockPanel.Dock="Right"
                    Content="Temizle"
                    ToolTip="Bu listedeki kopyaları siler. Resimler klasörüne dokunmaz."
                    Style="{StaticResource ClearButton}"
                    Click="Clear_Click" />
            <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center">
                <Run Text="Ekran görüntüleri" />
                <Run x:Name="ShotCount" Foreground="{StaticResource TextSecondary}" FontSize="12" />
            </TextBlock>
        </DockPanel>

        <ItemsControl x:Name="ShotList" Focusable="False" ItemTemplate="{StaticResource ShotTemplate}" Margin="0,0,-8,-8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock x:Name="ShotHint"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   Text="Sürükleyip istediğin yere bırak. Tıklayınca açılır." />
        <TextBlock x:Name="EmptyHint"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12"
                   Margin="0,6,0,6"
                   TextWrapping="Wrap"
                   Text="Henüz görüntü yok. Win + Shift + S ya da Win + PrtScn ile aldıkların burada birikir, son 10 tanesi saklanır." />

        <Border Height="1" Margin="0,14" Background="{StaticResource DividerBrush}" />

        <StackPanel x:Name="CopiedSection">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="CopiedClearButton"
                        DockPanel.Dock="Right"
                        Content="Temizle"
                        ToolTip="Listeyi boşaltır."
                        Style="{StaticResource ClearButton}"
                        Click="CopiedClear_Click" />
                <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center">
                    <Run Text="Kopyalananlar" />
                    <Run x:Name="CopiedCount" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                </TextBlock>
            </DockPanel>

            <!-- Beş satır görünür, fazlası tekerlekle kayar: kart ekranı kaplamasın -->
            <ScrollViewer x:Name="CopiedScroll"
                          MaxHeight="170"
                          Margin="-10,0"
                          Focusable="False"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="CopiedList" Focusable="False" ItemTemplate="{StaticResource CopiedTemplate}" />
            </ScrollViewer>

            <TextBlock x:Name="CopiedHint"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Text="Tıklayınca yeniden kopyalanır, sürükleyip istediğin yere bırakabilirsin." />
            <TextBlock x:Name="CopiedEmpty"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       Margin="0,2,0,6"
                       TextWrapping="Wrap"
                       Text="Henüz metin yok. Kopyaladığın son 10 metin burada birikir; yalnızca bellekte durur, IslandBar kapanınca silinir." />

            <Border Height="1" Margin="0,14" Background="{StaticResource DividerBrush}" />
        </StackPanel>

        <DockPanel Margin="0,0,0,8">
            <Button x:Name="ShelfClearButton"
                    DockPanel.Dock="Right"
                    Content="Temizle"
                    ToolTip="Listeyi boşaltır, dosyalara dokunmaz."
                    Style="{StaticResource ClearButton}"
                    Click="ShelfClear_Click" />
            <Border x:Name="ShelfAll"
                    DockPanel.Dock="Right"
                    CornerRadius="10"
                    Padding="8,2"
                    Cursor="Hand"
                    Background="Transparent"
                    ToolTip="Raftaki tüm dosyaları birlikte sürükle"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    MouseMove="Tile_MouseMove"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <TextBlock Text="Hepsini sürükle" FontSize="12" Foreground="{StaticResource TextSecondary}" />
            </Border>
            <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center">
                <Run Text="Dosya rafı" />
                <Run x:Name="ShelfCount" Foreground="{StaticResource TextSecondary}" FontSize="12" />
            </TextBlock>
        </DockPanel>

        <Border x:Name="ShelfZone" CornerRadius="10" Background="Transparent">
            <Grid>
                <!-- İki satır görünür, fazlası tekerlekle kayar: kart ekranı kaplamasın -->
                <ScrollViewer x:Name="ShelfScroll"
                              MaxHeight="172"
                              Focusable="False"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ShelfList" Focusable="False" ItemTemplate="{StaticResource ShelfTemplate}" Margin="0,0,-8,-8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Grid x:Name="ShelfEmpty" Height="64">
                    <Rectangle RadiusX="10"
                               RadiusY="10"
                               Stroke="{StaticResource ShotStrokeHover}"
                               StrokeDashArray="4 3" />
                    <TextBlock Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="16,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="Dosyaları buraya sürükle, götüreceğin yere kadar burada beklesin." />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
