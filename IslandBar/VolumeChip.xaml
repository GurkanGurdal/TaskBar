<UserControl x:Class="IslandBar.VolumeChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IslandBar"
             FontFamily="{StaticResource UiFont}"
             IsHitTestVisible="False">
    <local:GlassCard x:Name="Card"
                     AllowDrop="False"
                     RenderTransformOrigin="0.5,0.5">
        <local:GlassCard.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Pop" />
                <TranslateTransform x:Name="Slide" />
            </TransformGroup>
        </local:GlassCard.RenderTransform>
        <Grid>
            <Path x:Name="Track" Stroke="{StaticResource RailTrack}" />
            <Path x:Name="Ring" Stroke="{StaticResource AccentFill}" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <TextBlock x:Name="Number"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource ClockFont}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <Path x:Name="MutedMark"
                  Fill="{StaticResource TextPrimary}"
                  Stroke="{StaticResource TextPrimary}"
                  StrokeLineJoin="Round"
                  Visibility="Collapsed" />
        </Grid>
    </local:GlassCard>
</UserControl>
