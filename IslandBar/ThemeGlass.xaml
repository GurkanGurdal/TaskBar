<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Cam tema: arkadaki ekranın görüntüsü üstünde yarı saydam katmanlar. Anahtarlar ThemeWhite.xaml ile aynı olmalı. -->

    <!-- Yüzeyler -->
    <!-- Adanın ve kartın dinlenme tonu; camda görüntüye göre değişir (GlassTint) -->
    <Color x:Key="SurfaceColor">#24FFFFFF</Color>
    <!-- Kenar ışığı: sol üstten vurur, altta hafifçe geri döner -->
    <LinearGradientBrush x:Key="IslandStroke" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.5" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Camın üst yarısındaki yumuşak parlama -->
    <LinearGradientBrush x:Key="IslandSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F52A2B31" Offset="0" />
        <GradientStop Color="#F81C1D21" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StartBodyVeil" Color="#30101216" />
    <SolidColorBrush x:Key="MenuVeil" Color="#30101216" />
    <SolidColorBrush x:Key="StartRailFill" Color="#1F000000" />
    <SolidColorBrush x:Key="FooterFill" Color="#1A000000" />

    <!-- Vurgu: renk değil parlaklık. Açık durumlar düz kırık beyaz, üstünde koyu ikon; camın her renginde okunur. -->
    <SolidColorBrush x:Key="AccentFill" Color="#F2F4F8" />
    <SolidColorBrush x:Key="AccentInk" Color="#14161A" />
    <SolidColorBrush x:Key="OnAccentHover" Color="#14000000" />
    <SolidColorBrush x:Key="OnAccentDivider" Color="#26000000" />
    <LinearGradientBrush x:Key="FolderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD98A" Offset="0" />
        <GradientStop Color="#F0A93C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AttentionFill" Color="#FFB84D" />

    <!-- Düğme ve kutu zeminleri -->
    <SolidColorBrush x:Key="SubtleFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtleStroke" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MutedFill" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="RailTrack" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="DropHighlight" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ShotStroke" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ShotStrokeHover" Color="#B3FFFFFF" />

    <!-- Çalışan uygulama göstergeleri -->
    <SolidColorBrush x:Key="MarkFill" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="MarkMoreFill" Color="#B0FFFFFF" />

    <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FB" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3ABBD" />

    <!-- Gölgeler -->
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="IslandShadowBlur">14</sys:Double>
    <sys:Double x:Key="IslandShadowDepth">2</sys:Double>
    <sys:Double x:Key="IslandShadowOpacity">0.55</sys:Double>
    <sys:Double x:Key="CardShadowBlur">18</sys:Double>
    <sys:Double x:Key="CardShadowDepth">4</sys:Double>
    <sys:Double x:Key="CardShadowDirection">315</sys:Double>
    <sys:Double x:Key="CardShadowOpacity">0.55</sys:Double>
</ResourceDictionary>
