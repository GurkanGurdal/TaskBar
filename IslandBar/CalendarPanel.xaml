<UserControl x:Class="IslandBar.CalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             Background="Transparent"
             MouseWheel="Panel_MouseWheel">
    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Zemini yalnızca üzerine gelince görünen düğme -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Bugün: saatle aynı yazı tipinde. Tıklayınca başka aydan bugüne döner. -->
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Tarih ve saat ayarları"
                    ToolTip="Tarih ve saat ayarları"
                    Click="Settings_Click">
                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE713;" />
            </Button>
            <Button Style="{StaticResource GhostButton}"
                    Width="Auto"
                    Height="Auto"
                    Padding="6,2,10,4"
                    Margin="-6,-2,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Bugüne dön"
                    Click="Today_Click">
                <StackPanel>
                    <TextBlock x:Name="TodayWeekday" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="TodayDate" FontFamily="{StaticResource ClockFont}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,10" />

        <DockPanel Margin="0,0,0,6">
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Sonraki ay"
                    Click="Next_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" />
            </Button>
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Önceki ay"
                    Click="Previous_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" />
            </Button>
            <TextBlock x:Name="MonthTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
        </DockPanel>

        <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,0,0,2" />

        <!-- Ay değişince ızgara gidilen yönden kısa bir kayışla yerine oturur -->
        <Border ClipToBounds="True">
            <UniformGrid x:Name="DayGrid" Columns="7" Rows="6">
                <UniformGrid.RenderTransform>
                    <TranslateTransform x:Name="GridSlide" />
                </UniformGrid.RenderTransform>
            </UniformGrid>
        </Border>
    </StackPanel>
</UserControl>
