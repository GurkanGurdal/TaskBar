<UserControl x:Class="IslandBar.CalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             Background="Transparent"
             MouseWheel="Panel_MouseWheel">
    <UserControl.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Zemini yalnızca üzerine gelince görünen düğme -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentFill}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource ShotStroke}" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Bugün: saatle aynı yazı tipinde. Tıklayınca başka aydan bugüne döner. -->
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Tarih ve saat ayarları"
                    ToolTip="Tarih ve saat ayarları"
                    Click="Settings_Click">
                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE713;" />
            </Button>
            <Button Style="{StaticResource GhostButton}"
                    Width="Auto"
                    Height="Auto"
                    Padding="6,2,10,4"
                    Margin="-6,-2,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Bugüne dön"
                    Click="Today_Click">
                <StackPanel>
                    <TextBlock x:Name="TodayWeekday" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="TodayDate" FontFamily="{StaticResource ClockFont}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,10" />

        <DockPanel Margin="0,0,0,6">
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Sonraki ay"
                    Click="Next_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" />
            </Button>
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="Önceki ay"
                    Click="Previous_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" />
            </Button>
            <TextBlock x:Name="MonthTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
        </DockPanel>

        <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0,0,0,2" />

        <!-- Ay değişince ızgara gidilen yönden kısa bir kayışla yerine oturur -->
        <Border ClipToBounds="True">
            <UniformGrid x:Name="DayGrid" Columns="7" Rows="6">
                <UniformGrid.RenderTransform>
                    <TranslateTransform x:Name="GridSlide" />
                </UniformGrid.RenderTransform>
            </UniformGrid>
        </Border>

        <!-- Hatırlatıcılar (kullanıcının seçimi: takvimde; güne tıkla, o güne ekle). Diskte tutulur. -->
        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,8,0,10" />
        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="ReminderDay" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <TextBlock Text="Hatırlatıcılar" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl x:Name="ReminderList" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Height="30" Padding="6,0" CornerRadius="8" Background="Transparent">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Sil" Click="DeleteReminder_Click" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" Text="&#xEA8F;" />
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Text="{Binding TimeLabel}" />
                            <TextBlock FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text}" ToolTip="{Binding Text}" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Width="Auto"
                    Padding="10,0"
                    Background="{StaticResource MutedFill}"
                    Content="Ekle"
                    FontSize="12.5"
                    Click="AddReminder_Click" />
            <TextBox x:Name="ReminderTime"
                     DockPanel.Dock="Right"
                     Style="{StaticResource FieldBox}"
                     Width="58"
                     Margin="6,0"
                     MaxLength="5"
                     ToolTip="Saat (ör. 18:30)"
                     KeyDown="ReminderField_KeyDown" />
            <TextBox x:Name="ReminderText"
                     Style="{StaticResource FieldBox}"
                     MaxLength="120"
                     KeyDown="ReminderField_KeyDown" />
        </DockPanel>
        <TextBlock x:Name="ReminderHint"
                   Margin="0,6,0,0"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}"
                   Text="Güne tıklayıp o güne ekle. Zamanı gelince kart sen Tamam diyene kadar kalır." />
    </StackPanel>
</UserControl>
