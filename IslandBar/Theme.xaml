<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:IslandBar">
    <!-- Renkler ve gölge değerleri temanın paletinde (ThemeGlass.xaml, ThemeWhite.xaml) -->
    <local:IconInkConverter x:Key="IconInk" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ClockFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Açılır kartların camı: katmanlar adayla aynı (BarWindow.xaml, MainIsland) -->
    <Style TargetType="local:GlassCard">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GlassCard">
                    <Grid>
                        <Grid x:Name="PART_ShadowHost" Margin="-20" IsHitTestVisible="False">
                            <Border x:Name="PART_ShadowBorder" Margin="20" Background="Black" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="{StaticResource CardShadowBlur}" ShadowDepth="{StaticResource CardShadowDepth}" Direction="{StaticResource CardShadowDirection}" Opacity="{StaticResource CardShadowOpacity}" />
                                </Border.Effect>
                            </Border>
                            <!-- Canvas içinde: resim eski boyunda kaldığında kartın küçülmesini engellemesin -->
                            <Canvas>
                                <Image x:Name="PART_ShadowImage" Stretch="None" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                        <Grid x:Name="PART_GlassHost" IsHitTestVisible="False">
                            <Rectangle x:Name="PART_GlassImage" RenderOptions.BitmapScalingMode="Linear" />
                        </Grid>
                        <Border x:Name="PART_Fallback"
                                Visibility="Collapsed"
                                Background="{StaticResource PopupFill}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="PART_Tint"
                                BorderBrush="{StaticResource IslandStroke}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="PART_Sheen"
                                Margin="1"
                                Background="{StaticResource IslandSheen}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İpucu -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <local:GlassCard x:Name="Card" Margin="14" Padding="10,6" CornerRadius="9">
                        <ContentPresenter />
                    </local:GlassCard>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sağ tık menüleri: kartlarla aynı cam. Yazı ağırlıklı olduğu için daha bulanık, altında hafif bir örtü. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <local:GlassCard x:Name="Card" Margin="14" MinWidth="190" CornerRadius="13" BlurRadius="24">
                        <Border Padding="0,5" Background="{StaticResource MenuVeil}" CornerRadius="13">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </local:GlassCard>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,5" Background="{StaticResource DividerBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Margin="5,1" Padding="8,6" CornerRadius="8" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check"
                                  Data="M0,4 L3.5,7.5 L10,0.5"
                                  Stroke="{StaticResource AccentFill}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Path x:Name="Arrow"
                                  Grid.Column="2"
                                  Data="M0,0 L4,4 L0,8"
                                  Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-8"
                                   VerticalOffset="-20"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <local:GlassCard x:Name="SubCard" Margin="14" MinWidth="170" CornerRadius="13" BlurRadius="24">
                                    <Border Padding="0,5" Background="{StaticResource MenuVeil}" CornerRadius="13">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </local:GlassCard>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
