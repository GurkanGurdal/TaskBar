<Window x:Class="IslandBar.LayoutBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Düzenleme modu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="BannerButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SubtleFill}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="15" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Gölge payı -->
    <Grid Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Border CornerRadius="16" Background="{StaticResource PopupFill}">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource ShadowColor}"
                                  BlurRadius="{StaticResource CardShadowBlur}"
                                  ShadowDepth="{StaticResource CardShadowDepth}"
                                  Direction="{StaticResource CardShadowDirection}"
                                  Opacity="{StaticResource CardShadowOpacity}" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource IslandStroke}" Padding="18,12,12,12">
            <DockPanel>
                <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Style="{StaticResource BannerButton}" Content="Vazgeç" Click="Cancel_Click" />
                    <Button Style="{StaticResource BannerButton}"
                            Background="{StaticResource AccentFill}"
                            Foreground="{StaticResource AccentInk}"
                            FontWeight="SemiBold"
                            Margin="8,0,0,0"
                            Content="Düzeni kaydet"
                            Click="Save_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" Text="Düzenleme modu" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="Detail" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
