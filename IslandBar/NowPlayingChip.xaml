<UserControl x:Class="IslandBar.NowPlayingChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IslandBar"
             FontFamily="{StaticResource UiFont}"
             MouseEnter="Chip_MouseEnter"
             MouseLeave="Chip_MouseLeave"
             MouseLeftButtonDown="Chip_MouseLeftButtonDown"
             MouseRightButtonUp="Chip_MouseRightButtonUp"
             Cursor="Hand">
    <local:GlassCard x:Name="Card"
                     AllowDrop="False"
                     MinWidth="168">
        <local:GlassCard.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="BudSlide" />
                <TranslateTransform x:Name="CardSlide" />
            </TransformGroup>
        </local:GlassCard.RenderTransform>
        <Grid x:Name="ChipContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Kapak; yoksa nota işareti -->
            <!-- Üstte: yazılar açılırken kapağın altından çıkar -->
            <Border x:Name="CoverFrame" Panel.ZIndex="1" Background="{StaticResource MutedFill}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CoverScale" />
                        <RotateTransform x:Name="CoverTilt" />
                        <TranslateTransform x:Name="CoverSlide" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <TextBlock x:Name="CoverGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Text="&#xEC4F;" />
                    <Border x:Name="CoverImage">
                        <Border.Background>
                            <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="TextStack" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="ArtistText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ArtistSlide" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Kapak renginde küçük çubuklar: bu kartın müzikle ilgili olduğu bir bakışta anlaşılsın -->
            <StackPanel x:Name="BarsPanel"
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Height="12"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,1">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="BarsScale" />
                </StackPanel.RenderTransform>
                <Rectangle x:Name="Bar1" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale1" ScaleY="0.4" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar2" Width="2.5" Height="12" Margin="2,0" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale2" ScaleY="0.7" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar3" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale3" ScaleY="0.5" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>
        </Grid>
    </local:GlassCard>
</UserControl>
