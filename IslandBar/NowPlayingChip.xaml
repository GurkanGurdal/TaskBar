<UserControl x:Class="IslandBar.NowPlayingChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IslandBar"
             FontFamily="{StaticResource UiFont}"
             MouseEnter="Chip_MouseEnter"
             MouseLeave="Chip_MouseLeave"
             MouseLeftButtonDown="Chip_MouseLeftButtonDown"
             MouseRightButtonUp="Chip_MouseRightButtonUp"
             Cursor="Hand">
    <local:GlassCard x:Name="Card"
                     AllowDrop="False"
                     MinWidth="168">
        <local:GlassCard.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" />
                <TranslateTransform x:Name="BudSlide" />
                <TranslateTransform x:Name="CardSlide" />
            </TransformGroup>
        </local:GlassCard.RenderTransform>
        <Grid x:Name="ChipContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Kapak; yoksa nota işareti -->
            <!-- Üstte: yazılar açılırken kapağın altından çıkar -->
            <Border x:Name="CoverFrame" Panel.ZIndex="1" Background="{StaticResource MutedFill}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CoverScale" />
                        <RotateTransform x:Name="CoverTilt" />
                        <TranslateTransform x:Name="CoverSlide" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <TextBlock x:Name="CoverGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Text="&#xEC4F;" />
                    <Border x:Name="CoverImage">
                        <Border.Background>
                            <ImageBrush x:Name="Cover" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="TextStack" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="ArtistText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="ArtistSlide" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>

            <!-- Kapak renginde küçük çubuklar: bu kartın müzikle ilgili olduğu bir bakışta anlaşılsın -->
            <StackPanel x:Name="BarsPanel"
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        Height="12"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,1">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="BarsScale" />
                </StackPanel.RenderTransform>
                <Rectangle x:Name="Bar1" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale1" ScaleY="0.4" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar2" Width="2.5" Height="12" Margin="2,0" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale2" ScaleY="0.7" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="Bar3" Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BarScale3" ScaleY="0.5" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>

            <!-- Claude kartında çubukların yerinde: bitti işareti ya da onay bekliyor noktası -->
            <Grid x:Name="ClaudeMark"
                  Grid.Column="2"
                  Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MarkScale" />
                </Grid.RenderTransform>
                <TextBlock x:Name="DoneMark"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           Text="&#xE73E;" />
                <!-- Onay beklerken noktadan sonar gibi halkalar yayılır (kullanıcının seçimi) -->
                <Grid x:Name="WaitMark" Width="8" Height="8" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Stroke="{StaticResource AttentionFill}" StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5" x:Name="WaitRing1">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RingScale1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Stroke="{StaticResource AttentionFill}" StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5" x:Name="WaitRing2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RingScale2" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Fill="{StaticResource AttentionFill}" />
                </Grid>
            </Grid>

            <!-- Hatırlatıcıda: kart kullanıcı seçene kadar kalır (kullanıcının seçimi) -->
            <StackPanel x:Name="NoticeActions"
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Margin" Value="6,0,0,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Plate" CornerRadius="8" Background="{StaticResource MutedFill}" Padding="10,4">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Plate" Property="Background" Value="{StaticResource HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button Content="Ertele 10 dk" Click="Snooze_Click" />
                <Button Content="Tamam" Click="Done_Click" />
            </StackPanel>
        </Grid>
    </local:GlassCard>
</UserControl>
