<Window x:Class="IslandBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandBar Ayarları"
        Width="440"
        Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="8,0,0,4" />
        </Style>
    </Window.Resources>
    <TabControl Margin="8">
        <TabItem Header="Genel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kenar" VerticalAlignment="Center" />
                    <ComboBox x:Name="EdgeBox"
                              Grid.Column="1"
                              AutomationProperties.Name="Kenar"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Edge}" />
                    <TextBlock Grid.Row="1" Text="Kalınlık" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox x:Name="ThicknessBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Kalınlık"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Thickness}" />
                    <TextBlock Grid.Row="2" Text="Tema" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <ComboBox x:Name="ThemeBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="Tema"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Theme}" />
                </Grid>
                <CheckBox Content="Çubuğu otomatik gizle" Margin="0,16,0,0" IsChecked="{Binding AutoHideBar}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Fareyi ekranın kenarına götürünce açılır." />
                <CheckBox Content="Altında pencere yokken saate dönüşsün"
                          Margin="20,8,0,0"
                          IsEnabled="{Binding AutoHideBar}"
                          IsChecked="{Binding ClockChipOnDesktop}" />
                <CheckBox Content="IslandBar Başlat menüsünü kullan" Margin="0,16,0,0" IsChecked="{Binding CustomStartMenu}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Kapalıyken Başlat düğmesi ve Windows tuşu Windows'un kendi menüsünü açar." />
                <CheckBox Content="Ekran görüntülerini IslandBar Araçları'nda sakla" Margin="0,16,0,0" IsChecked="{Binding KeepScreenshots}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Son 10 görüntünün kopyası bu bilgisayarda şifresiz tutulur. Kapatınca yenisi eklenmez, eskileri kartın Temizle düğmesiyle silersin." />
                <CheckBox Content="Kopyalanan metinleri IslandBar Araçları'nda tut" Margin="0,16,0,0" IsChecked="{Binding KeepCopiedText}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Son 10 metin yalnızca bellekte tutulur, diske yazılmaz; IslandBar kapanınca silinir. Parola yöneticilerinin gizli işaretlediği metinler alınmaz. Kapatınca liste de boşalır." />
                <CheckBox Content="Spotify'da yeni şarkı başlayınca göster" Margin="0,16,0,0" IsChecked="{Binding ShowNowPlayingChip}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Çubuğun yanında birkaç saniyelik küçük bir kart çıkar. Tam ekranda çıkmaz." />
                <CheckBox Content="Claude Code bitirince ya da onay bekleyince göster" Margin="0,16,0,0" IsChecked="{Binding ShowClaudeChip}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Şarkı kartıyla aynı yerde çıkar. Claude zaten öndeyse çıkmaz. Bunun için IslandBar, Claude Code'un ayar dosyasına (kullanıcı klasörünüzde .claude\settings.json) kendi kancasını yazar: Claude Code her cevabı bitirdiğinde ve onay beklediğinde IslandBar'ı çağırır. Dosyadaki öteki ayarlarınıza dokunulmaz; kapatınca kanca silinir. Claude Code kurulu değilse dosyaya bir şey yazılmaz." />
                <CheckBox Content="Ses tuşlarında çubuğun göstergesini kullan" Margin="0,16,0,0" IsChecked="{Binding ShowVolumeChip}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Kapalıyken Windows'un kendi göstergesi çıkar." />
                <TextBlock Text="İkinci ekran varken şarkı sözleri" Margin="0,16,0,4" />
                <ComboBox Width="260" HorizontalAlignment="Left" SelectedIndex="{Binding LyricsScreen}">
                    <ComboBoxItem Content="Sor" />
                    <ComboBoxItem Content="İkinci ekranda tam ekran" />
                    <ComboBoxItem Content="Ana ekranda tam ekran" />
                </ComboBox>
                <TextBlock Text="İkinci ekrandaki çerçeve" Margin="0,12,0,4" />
                <ComboBox Width="260" HorizontalAlignment="Left" SelectedIndex="{Binding LyricsFrame}">
                    <ComboBoxItem Content="İkili tur" />
                    <ComboBoxItem Content="Kenar ekolayzır (sese göre)" />
                    <ComboBoxItem Content="Lunapark" />
                </ComboBox>
                <CheckBox x:Name="ClockCheck" Content="Saati göster" Margin="0,16,0,0" IsChecked="{Binding ShowClock}" />
                <CheckBox Content="Tarihi göster"
                          Margin="20,6,0,0"
                          IsChecked="{Binding ShowDate}"
                          IsEnabled="{Binding IsChecked, ElementName=ClockCheck}" />
                <CheckBox x:Name="StartupCheck" Content="Windows'la başlat" Margin="0,16,0,0" />
                <CheckBox Content="Windows görev çubuğunu gizle" Margin="0,6,0,0" IsChecked="{Binding HideWindowsTaskbar}" />
                <TextBlock Margin="20,2,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Kapalıyken IslandBar, Windows çubuğunun yanında ek çubuk olarak durur." />
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Düzen">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2" Text="Sabitlenen uygulamalar" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="PinnedList"
                         Grid.Row="1"
                         AutomationProperties.Name="Sabitlenen uygulamalar"
                         ItemsSource="{Binding Pinned}"
                         DisplayMemberPath="Name"
                         SelectionChanged="List_SelectionChanged" />
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Button x:Name="PinnedUpButton" Style="{StaticResource SideButton}" Content="Yukarı" Click="PinnedUpButton_Click" />
                    <Button x:Name="PinnedDownButton" Style="{StaticResource SideButton}" Content="Aşağı" Click="PinnedDownButton_Click" />
                    <Button x:Name="PinnedRemoveButton" Style="{StaticResource SideButton}" Content="Kaldır" Click="PinnedRemoveButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Düzenler" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ListBox x:Name="GroupList"
                         Grid.Row="3"
                         AutomationProperties.Name="Düzenler"
                         ItemsSource="{Binding Groups}"
                         DisplayMemberPath="Name"
                         SelectionChanged="List_SelectionChanged" />
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <Button x:Name="GroupUpButton" Style="{StaticResource SideButton}" Content="Yukarı" Click="GroupUpButton_Click" />
                    <Button x:Name="GroupDownButton" Style="{StaticResource SideButton}" Content="Aşağı" Click="GroupDownButton_Click" />
                    <Button x:Name="GroupRenameButton" Style="{StaticResource SideButton}" Content="Yeniden adlandır" Click="GroupRenameButton_Click" />
                    <Button x:Name="GroupDeleteButton" Style="{StaticResource SideButton}" Content="Sil" Click="GroupDeleteButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           Foreground="#606060"
                           TextWrapping="Wrap"
                           Text="Eklemek için dosyaları çubuğa sürükleyin ya da çubuğa sağ tıklayın." />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
